# Адрес эмулятора Keitaro (без /admin_api/v1)
KEITARO_URL=https://keitaro-for-tests.etolegko.com
# Ключ из админки: кнопка «API ключ» вверху справа
KEITARO_API_KEY=put-your-key-here

# База для локальной истории (SQLite по умолчанию, подойдет и Postgres:
# postgresql+psycopg://user:pass@localhost:5432/keitaro)
DATABASE_URL=sqlite:///./app.db

# Префикс имён кампаний по требованию задания: test_фамилия_
CAMPAIGN_PREFIX=test_ivanov_

# Значения по умолчанию для новой кампании
DEFAULT_DOMAIN_ID=1813
DEFAULT_GROUP_ID=10332
DEFAULT_TRAFFIC_SOURCE_ID=836

# Куда редиректит гео-поток
GEO_REDIRECT_URL=https://google.com
